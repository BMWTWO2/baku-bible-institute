<%- include('partials/head') %>
<section class="login rise"><div class="card"><h1>New password · Yeni şifrə</h1>
<% if (invalid) { %>
<p class="err">Bu link köhnəlib və ya artıq istifadə olunub. Zəhmət olmasa, yeni link istəyin.<br>This link has expired or was already used. Please ask for a new one.</p>
<p style="text-align:center"><a class="btn full" href="/forgot-password">Yeni link · Get a new link</a></p>
<% } else { %>
<p class="muted">Yeni şifrənizi iki dəfə yazın (ən azı 8 simvol).<br>Type your new password twice (at least 8 characters).</p>
<% if (error) { %><p class="err"><%= error %></p><% } %>
<form method="post" action="/reset-password"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="token" value="<%= token %>">
<label>New password · Yeni şifrə<input name="password" type="password" required minlength="8" autocomplete="new-password"></label>
<label>Repeat · Təkrar yazın<input name="confirm_password" type="password" required minlength="8" autocomplete="new-password"></label>
<button class="btn full">Şifrəni dəyiş · Change password</button></form>
<% } %></div></section>
<%- include('partials/foot') %>
