<!doctype html><html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> · Baku Bible Institute</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css"><script src="/app.js" defer></script></head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<% if (demo) { %><div class="demo-bar">DEMO DATA — fictional students · <%= typeof lang !== 'undefined' && lang==='az' ? 'Nümunə məlumatlar' : 'not real records' %></div><% } %>
<header class="topbar"><a class="brand" href="/"><span class="mark">✦</span><span><b>Baku Bible</b> Institute</span></a>
<nav><% if (user && user.role !== 'student') { const L=[['/admin','Dashboard','admin'],['/admin/students','Roster','admin'],['/admin/classes','Classes'],['/admin/attendance','Attendance'],['/admin/gradebook','Grades'],['/admin/homework','Homework'],['/admin/whatsapp','WhatsApp','admin'],['/admin/bots','Bots','admin'],['/admin/report','Report','admin']]; L.filter(l=>!l[2]||user.role==='admin').forEach(l=>{ %><a href="<%= l[0] %>" class="<%= path===l[0]||(l[0]!=='/admin'&&path.startsWith(l[0]))?'on':'' %>"><%= l[1] %></a><% }) } else if (user) { %><a href="/telebe" class="on">Kabinet</a><% } %>
<% if (user) { %><form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link"><%= user.role==='student'?'Çıxış':'Sign out' %></button></form><% } else { %><a href="/login" class="btn sm">Sign in · Daxil ol</a><% } %></nav></header>
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
<main class="<%= typeof wide !== 'undefined' ? 'wide' : 'wrap' %>">
