<%- include('../partials/head') %>
<div class="pagehead rise"><h1>Homework review · Ev tapşırıqları</h1></div>
<div class="list rise d1"><% subs.forEach(s=>{ %><a class="card hw" href="/admin/homework/<%= s.id %>"><div><p class="eyebrow"><%= s.code %> · <%= s.source %></p><h3><%= s.title_az %></h3><p class="muted"><%= s.student %></p></div><p class="az clamp"><%= s.body %></p>
<span class="pill <%= s.status==='returned'?'green':s.status==='draft_ready'?'blue':'amber' %>"><%= {submitted:'Needs draft',draft_ready:'Draft ready',returned:'Returned'}[s.status] %></span></a><% }) %></div>
<%- include('../partials/foot') %>
