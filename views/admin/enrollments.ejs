<%- include('../partials/head') %>
<div class="pagehead rise"><div><p class="eyebrow"><a href="/admin">Dashboard</a></p><h1>Enrollment requests</h1>
<p class="muted">Homepage form submissions. New students are added to the roster without a login. A full class is not over-enrolled — those requests are flagged for review.</p></div></div>
<% if (!rows.length) { %><p class="muted rise">No enrollment requests yet.</p><% } else { %>
<table class="tbl rise d1"><thead><tr><th>When</th><th>Name</th><th>Phone</th><th>WhatsApp</th><th>Classes</th><th>Student</th><th>Flag</th><th>Notified</th><th></th></tr></thead><tbody>
<% rows.forEach(r => { %>
<tr>
  <td class="small"><%= r.created_at %></td>
  <td><b><%= r.name %></b></td>
  <td class="small"><%= r.phone %></td>
  <td class="small"><%= r.whatsapp_phone || '—' %></td>
  <td class="small">Asked: <%= r.classes.join(', ') || '—' %><br>
    <% if (r.enrolled.length) { %><span class="pill green">enrolled <%= r.enrolled.join(', ') %></span><% } %>
    <% if (r.full.length) { %><span class="pill amber">full <%= r.full.join(', ') %></span><% } %>
  </td>
  <td><% if (r.student_id) { %><a href="/admin/students/<%= r.student_id %>">#<%= r.student_id %></a><% if (r.existing_student) { %><br><span class="pill blue">existing</span><% } %><% } else { %>—<% } %></td>
  <td><% if (r.review_flag) { %><span class="pill <%= r.review_flag.includes('full')?'amber':'blue' %>"><%= r.review_flag %></span><% } else { %><span class="muted">—</span><% } %></td>
  <td><% if (r.notified) { %><span class="pill green">yes</span><span class="small muted"><%= r.notified_at||'' %></span><% } else { %><span class="pill amber">pending</span><% } %></td>
  <td>
    <% if (!r.notified) { %><form method="post" action="/admin/enrollments/<%= r.id %>/notified" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm">Mark notified</button></form><% } %>
    <form method="post" action="/admin/enrollments/<%= r.id %>/discard" class="inline" onsubmit="return confirm('Remove this request? A new student with no login and no class activity will also be removed from the roster.')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link">Remove</button></form>
  </td>
</tr>
<% }) %>
</tbody></table>
<% } %>
<%- include('../partials/foot') %>
