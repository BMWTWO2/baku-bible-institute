<%- include('../partials/head') %>
<article class="report rise"><p class="eyebrow">📖 Chronicler · Weekly director’s report · <%= r.generated.slice(0,10) %></p><h1>Baku Bible Institute — this week</h1>
<div class="kpis"><div class="kpi"><b><%= r.totals.students %></b><span>active</span></div><div class="kpi"><b><%= r.totals.attendanceRate ?? '—' %>%</b><span>attendance</span></div><div class="kpi"><b><%= r.totals.pendingWhatsApp %></b><span>WhatsApp pending</span></div><div class="kpi"><b><%= r.totals.homeworkAwaiting %></b><span>homework to review</span></div></div>
<% [['sentinel','Attendance flags (more than 2 unexcused)'],['shepherd','At-risk students'],['scribe','Missing grades'],['herald','Pending WhatsApp & applicants'],['helper','Homework awaiting review'],['steward','Class capacity'],['watchman','Data integrity']].forEach(([k,h])=>{ const b=bots.find(x=>x.key===k); %>
<section><h2><%= b.icon %> <%= h %> <span class="pill"><%= r.findings[k].length %></span></h2><% if (!r.findings[k].length) { %><p class="muted">All clear.</p><% } else { %><ul><% r.findings[k].forEach(x=>{ %><li><a href="<%= x.link %>"><%= x.text %></a></li><% }) %></ul><% } %></section><% }) %>
<p class="small muted">Sample report built from demo data. JSON: <a href="/admin/report.json">/admin/report.json</a></p></article>
<%- include('../partials/foot') %>
