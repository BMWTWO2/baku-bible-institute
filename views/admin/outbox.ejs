<%- include('../partials/head') %>
<div class="pagehead rise"><div><h1>Email outbox</h1><p class="muted">Every email waits here. <b>Nothing is sent unless you click Send.</b> Sender: <%= cfg.fromName %> &lt;<%= cfg.from %>&gt;.</p></div></div>
<div class="kpis rise d1"><% ['pending','sent','failed','discarded','all'].forEach(k=>{ %><a class="kpi <%= status===k?'warn':'' %>" href="/admin/outbox?status=<%= k %>"><b><%= k==='all' ? Object.values(counts).reduce((a,b)=>a+b,0) : counts[k] %></b><span><%= k %></span></a><% }) %></div>
<section class="card rise d1"><p>Sending switch: <span class="pill <%= cfg.enabled?'green':'red' %>"><%= cfg.enabled?'ON':'OFF (EMAIL_SENDING_ENABLED is not true)' %></span> · Mail credential: <span class="pill <%= cfg.hasKey?'green':'amber' %>"><%= cfg.hasKey?'configured':'not set' %></span></p>
<form method="post" action="/admin/outbox/verify" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost">Check mail credential (sends nothing)</button></form>
<% if (check) { %><p class="<%= check.ok?'flash':'note' %>"><%= check.detail %></p><% } %>
<% if (status==='pending' && msgs.length) { %><form method="post" action="/admin/outbox/send-all" class="row"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="row small"><input type="checkbox" name="confirm" value="yes" style="width:auto"> I have read all <%= msgs.length %> pending emails below and approve sending them</label><button class="btn gold sm">Send all pending</button></form><% } %></section>
<% if (!msgs.length) { %><p class="muted rise">No <%= status==='all'?'':status %> emails.</p><% } %>
<div class="list rise d2"><% msgs.forEach(m=>{ %><article class="card"><p class="eyebrow"><%= m.kind || 'email' %> · <%= m.created_at %> · <span class="pill <%= {pending:'amber',sent:'green',failed:'red',discarded:''}[m.status] %>"><%= m.status %></span><% if (m.error) { %> · <%= m.error %><% } %></p>
<p><b>To:</b> <%= m.to_name ? m.to_name + ' ' : '' %>&lt;<%= m.to_email %>&gt;</p>
<% if (['pending','failed'].includes(m.status)) { %><form method="post" action="/admin/outbox/<%= m.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Subject<input name="subject" value="<%= m.subject %>"></label><label>Message<textarea name="body_text" lang="az" rows="10"><%= m.body_text %></textarea></label>
<div class="row"><button class="btn ghost sm">Save edits</button><button class="btn gold sm" formaction="/admin/outbox/<%= m.id %>/send">Approve &amp; send</button><button class="btn ghost sm" formaction="/admin/outbox/<%= m.id %>/discard">Discard</button></div></form>
<% } else { %><% if (m.status==='discarded') { %><form method="post" action="/admin/outbox/<%= m.id %>/delete" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link small">Remove</button></form><% } %><p><b><%= m.subject %></b></p><p class="small" style="white-space:pre-wrap"><%= m.body_text %></p><% } %></article><% }) %></div>
<%- include('../partials/foot') %>
