<%- include('../partials/head') %>
<div class="pagehead rise"><div><h1>WhatsApp inbox</h1><p class="muted">Messages arrive at <code>POST /webhooks/whatsapp</code>. Bots suggest an action — nothing is applied until you click Apply.</p></div>
<div class="tabs"><% ['pending','applied','dismissed','all'].forEach(t=>{ %><a href="?status=<%= t %>" class="<%= status===t?'on':'' %>"><%= t %></a><% }) %></div></div>
<% if (!verifySet) { %><p class="note rise">WhatsApp is not connected yet (no WHATSAPP_VERIFY_TOKEN). Use “Simulate a message” to test.</p><% } %>
<div class="list rise d1"><% if (!msgs.length) { %><p class="muted">Nothing here.</p><% } %>
<% msgs.forEach(m=>{ const p=m.payload; const act=m.suggested_action; const sec=(sections.find(s=>s.code===p.course)||{}).id; %>
<article class="card wa <%= m.status %>"><div class="wa-head"><div class="avatar"><%= (m.contact_name||'?').trim()[0] %></div><div><b><%= m.contact_name || 'Unknown' %></b> <span class="muted small"><%= m.from_number %></span><br>
<span class="small"><%= m.student ? '↔ linked to ' + m.student : 'not matched to a student' %> · <%= m.received_at.slice(0,16).replace('T',' ') %> UTC</span></div>
<span class="pill <%= {mark_attendance:'blue',create_student:'green',record_grade:'gold',file_homework:'violet',none:''}[act] %>">suggested: <%= act.replace('_',' ') %></span><% if (m.is_demo) { %><span class="pill">demo</span><% } %></div>
<p class="bubble" lang="az"><%= m.body %></p>
<% if (m.status==='pending') { %><form method="post" action="/admin/whatsapp/<%= m.id %>/apply" class="apply" data-apply><input type="hidden" name="_csrf" value="<%= csrf %>">
<label>Action<select name="action" data-act><% [['create_student','Create student'],['mark_attendance','Mark attendance'],['record_grade','Record grade'],['file_homework','File homework']].forEach(a=>{ %><option value="<%= a[0] %>" <%= act===a[0]?'selected':'' %>><%= a[1] %></option><% }) %></select></label>
<span data-for="create_student"><label>Name<input name="name" value="<%= p.name||m.contact_name||'' %>"></label><label>Phone<input name="whatsapp_phone" value="<%= p.whatsapp_phone||m.from_number %>"></label><label>Lang<select name="preferred_language"><option>az</option><option>en</option><option>ru</option></select></label></span>
<span data-for="mark_attendance record_grade file_homework"><label>Student<select name="student_id"><option value="">—</option><% students.forEach(s=>{ %><option value="<%= s.id %>" <%= (p.student_id||m.student_id)===s.id?'selected':'' %>><%= s.name %></option><% }) %></select></label></span>
<span data-for="mark_attendance"><label>Class<select name="section_id"><option value="">—</option><% sections.forEach(s=>{ %><option value="<%= s.id %>" <%= sec===s.id?'selected':'' %>><%= s.code %></option><% }) %></select></label><label>Date<input type="date" name="date" value="<%= m.received_at.slice(0,10) %>"></label><label>Status<select name="status"><% ['present','late','absent','excused'].forEach(st=>{ %><option <%= p.status===st?'selected':'' %>><%= st %></option><% }) %></select></label></span>
<span data-for="record_grade"><label>Item<select name="grade_item_id"><% items.forEach(i=>{ %><option value="<%= i.id %>" <%= i.code===p.course&&/midterm/i.test(i.title)?'selected':'' %>><%= i.code %> · <%= i.title %></option><% }) %></select></label><label>Points<input class="num" name="points" type="number" value="<%= p.points ?? '' %>"></label></span>
<span data-for="file_homework"><label>Assignment<select name="assignment_id"><% assignments.forEach(a=>{ %><option value="<%= a.id %>"><%= a.code %> · <%= a.title_az %></option><% }) %></select></label></span>
<button class="btn sm">Apply</button></form>
<form method="post" action="/admin/whatsapp/<%= m.id %>/dismiss" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link">Dismiss</button></form><% } else { %><p class="small muted"><%= m.status %> <%= m.handled_at||'' %></p><% } %>
<details class="small"><summary>Raw JSON</summary><pre><%= m.raw_json %></pre></details></article><% }) %></div>
<details class="card rise"><summary><b>Simulate a message</b> (test only)</summary><form method="post" action="/admin/whatsapp/test" class="formgrid"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>From<input name="from" value="+994552000000"></label><label>Name<input name="name" value="Aysel"></label><label class="span">Text<input name="text" value="Salam, sabah dərsə gecikəcəyəm."></label><button class="btn sm">Send to inbox</button></form></details>
<%- include('../partials/foot') %>
