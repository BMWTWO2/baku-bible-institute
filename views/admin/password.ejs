<%- include('../partials/head') %>
<div class="pagehead rise"><h1>Change my password</h1></div>
<form method="post" class="card formgrid rise d1" style="max-width:520px"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label class="span">Current password<input type="password" name="current_password" autocomplete="current-password" required></label>
<label class="span">New password (12+ characters)<input type="password" name="new_password" autocomplete="new-password" minlength="12" required></label>
<label class="span">Repeat new password<input type="password" name="confirm_password" autocomplete="new-password" minlength="12" required></label>
<div class="span"><button class="btn gold">Change password</button></div></form>
<%- include('../partials/foot') %>
