<%- include('../partials/head') %>
<div class="pagehead rise"><div><h1>Gradebook</h1><p class="muted">Class averages are weighted by each item's weight. Homework items use the final score after any late deduction.</p></div>
<div class="row"><% sections.forEach(x=>{ %><a class="btn sm" href="/admin/gradebook/class/<%= x.id %>"><%= x.code %> averages &amp; final grades</a><% }) %></div></div>
<section class="card rise d1"><h2>Add a graded item (exam, quiz, participation…)</h2><p class="small muted">Homework assignments with due dates are created on <a href="/admin/assignments">Assignments</a>.</p>
<form method="post" action="/admin/gradebook" class="formgrid"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label>Class<select name="section_id" required><% sections.forEach(x=>{ %><option value="<%= x.id %>"><%= x.code %> — <%= x.title %></option><% }) %></select></label>
<label>Title<input name="title" required maxlength="200" placeholder="e.g. Midterm exam"></label>
<label>Max points<input class="num" type="number" name="max_points" min="0.5" step="0.5" value="100" required></label>
<label>Weight<input class="num" type="number" name="weight" min="0" step="0.1" value="1" required></label>
<label>Date (optional)<input type="date" name="due_date"></label>
<div><button class="btn gold">Add item</button></div></form></section>
<table class="tbl rise d2"><thead><tr><th>Course</th><th>Item</th><th>Type</th><th>Due</th><th>Max</th><th>Weight</th><th>Graded</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><%= i.code %></td><td><a href="/admin/gradebook/<%= i.id %>"><%= i.title %></a></td><td class="small"><%= i.assignment_id ? 'Homework' : 'Other' %></td><td><%= i.due_date %></td><td><%= i.max_points %></td><td><%= i.weight ?? 1 %></td><td><span class="pill <%= i.graded<i.n?'amber':'green' %>"><%= i.graded %>/<%= i.n %></span></td></tr><% }) %></tbody></table>
<% if (!items.length) { %><p class="muted">No graded items yet.</p><% } %>
<%- include('../partials/foot') %>
