<%- include('../partials/head') %>
<div class="pagehead rise"><div><h1>Gradebook</h1><p class="muted">Each class is graded: <b>attendance + participation 55%</b> · <b>final exam 25%</b> · <b>two written assignments 10% each</b>. Homework items use the final score after any late deduction.</p></div>
<div class="row"><% sections.forEach(x=>{ %><a class="btn sm" href="/admin/gradebook/class/<%= x.id %>"><%= x.code %> averages &amp; final grades</a><% }) %></div></div>
<section class="card rise d1"><h2>Add a graded item</h2><p class="small muted">Each class already has <b>Class participation</b> and <b>Final exam</b> items (enter scores there). Attendance is automatic from QR check-in; written assignments are created on <a href="/admin/assignments">Assignments</a>. Items marked “Not counted” (quizzes etc.) show on the student's list but don't change the weighted grade.</p>
<form method="post" action="/admin/gradebook" class="formgrid"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label>Class<select name="section_id" required><% sections.forEach(x=>{ %><option value="<%= x.id %>"><%= x.code %> — <%= x.title %></option><% }) %></select></label>
<label>Title<input name="title" required maxlength="200" placeholder="e.g. Midterm exam"></label>
<label>Max points<input class="num" type="number" name="max_points" min="0.5" step="0.5" value="100" required></label>
<label>Counts as<select name="kind"><% ['other','participation','final','homework'].forEach(k=>{ %><option value="<%= k %>"><%= grades.KIND_LABEL[k] %></option><% }) %></select></label>
<input type="hidden" name="weight" value="1">
<label>Date (optional)<input type="date" name="due_date"></label>
<div><button class="btn gold">Add item</button></div></form></section>
<table class="tbl rise d2"><thead><tr><th>Course</th><th>Item</th><th>Counts as</th><th>Due</th><th>Max</th><th>Graded</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><%= i.code %></td><td><a href="/admin/gradebook/<%= i.id %>"><%= i.title %></a></td><td class="small"><%= grades.KIND_LABEL[i.cat] %></td><td><%= i.due_date %></td><td><%= i.max_points %></td><td><span class="pill <%= i.graded<i.n?'amber':'green' %>"><%= i.graded %>/<%= i.n %></span></td></tr><% }) %></tbody></table>
<% if (!items.length) { %><p class="muted">No graded items yet.</p><% } %>
<%- include('../partials/foot') %>
