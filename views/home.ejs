<%- include('partials/head', { bodyClass: 'home', wide: 1 }) %>
<section class="hero">
  <div class="sky"></div><div class="sun"></div>
  <svg class="skyline" viewBox="0 0 1200 260" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <path class="flame f1" d="M800 260 C 790 150, 830 60, 860 20 C 880 80, 900 150, 880 260 Z"/><path class="flame f2" d="M880 260 C 875 140, 905 70, 930 45 C 950 100, 965 170, 950 260 Z"/><path class="flame f3" d="M740 260 C 735 170, 760 100, 790 75 C 805 130, 815 190, 805 260 Z"/>
    <path class="city" d="M0 260 V210 h60 v-30 h30 v40 h40 v-60 l20 -30 l20 30 v60 h50 v-20 h40 v-50 h18 v-30 h12 v30 h18 v50 h60 v-25 h80 v35 h70 v-40 h40 v60 H1200 V260 Z"/>
    <path class="maiden" d="M1010 260 V150 q30 -30 60 0 V260 Z"/>
  </svg>
  <div class="waves"><span></span><span></span></div>
  <div class="hero-copy rise"><p class="eyebrow">Bakı · Xəzər sahilində</p><h1>Baku Bible<br><em>Institute</em></h1>
    <p class="lead">Rooted in Scripture, taught in Azerbaijani. Müqəddəs Kitabı öyrənmək, xidmətə hazırlaşmaq — Xəzərin sahilində.</p>
    <div class="cta"><a class="btn gold" href="/login">Tələbə girişi · Student sign in</a><% if (enroll && enroll.open) { %><a class="btn ghost" href="#qeydiyyat">Bu həftə qeydiyyat · Enroll this week</a><% } else { %><a class="btn ghost" href="#programs">Proqramlar</a><% } %></div></div>
</section>
<section id="programs" class="band wrap">
  <div class="grid3">
    <article class="feature rise d1"><span class="ico">📖</span><h3>Theology of Grace</h3><p>THG 101 · Lütf İlahiyyatı — Allahın lütfü və imanla xilas, Azərbaycan dilində.</p></article>
    <article class="feature rise d2"><span class="ico">🕊️</span><h3>Body Life</h3><p>ECC 101 · Body Life — yerli kilsənin həyatı və xidməti.</p></article>
    <article class="feature rise d3"><span class="ico">✍️</span><h3>Taught by Pastor Bruce Wright</h3><p>İki fənn, bir müəllim — ev tapşırıqlarına ana dilində, müəllim tərəfindən təsdiqlənmiş rəy.</p></article>
  </div>
  <div class="stats rise"><div><b data-count="<%= stats.students %>">0</b><span>active students · tələbə</span></div><div><b data-count="<%= stats.courses %>">0</b><span>courses · fənn</span></div><div><b>az</b><span>taught in Azerbaijani</span></div></div>
  <blockquote class="verse rise">“Sənin sözün ayağım üçün çıraq, yolum üçün nurdur.”<cite>Zəbur 119:105</cite></blockquote>
</section>
<section id="qeydiyyat" class="enroll-band wrap">
  <div class="enroll-card rise">
    <p class="eyebrow">Qeydiyyat · Enrollment</p>
    <% if (typeof enrollThanks !== 'undefined' && enrollThanks) { %>
      <h2>Təşəkkür edirik!</h2>
      <p class="enroll-thanks">Qeydiyyatınız qəbul olundu. Pastor Bruce sizinlə əlaqə saxlayacaq. Allah sizi xeyir-dua etsin.</p>
      <p class="muted">Thank you — your enrollment request was received. Pastor Bruce will be in touch. God bless you.</p>
    <% } else if (!enroll || !enroll.open) { %>
      <h2>Qeydiyyat bağlanıb</h2>
      <p>Bu həftənin qeydiyyat müddəti bitib<% if (enroll && enroll.closeLabelAz) { %> (<%= enroll.closeLabelAz %>)<% } %>. Əgər köməyə ehtiyacınız varsa, zəhmət olmasa Pastor Bruce ilə əlaqə saxlayın.</p>
      <p class="muted">Enrollment is now closed. Please contact Pastor Bruce Wright if you need help.</p>
    <% } else { %>
      <h2>Bu həftə qeydiyyatdan keçin</h2>
      <p class="enroll-note">Qeydiyyat <b><%= enroll.closeLabelAz %></b> bağlanır. Yalnız bu həftə ərzində açıqdır.<br><span class="muted">Enrollment closes <%= enroll.closeLabelEn %>. This form is open this week only.</span></p>
      <% if (typeof enrollErrors !== 'undefined' && enrollErrors && enrollErrors.length) { %>
        <ul class="enroll-errors"><% enrollErrors.forEach(e => { %><li><%= e.az %> <span class="muted"><%= e.en %></span></li><% }) %></ul>
      <% } %>
      <% const v = typeof enrollValues !== 'undefined' && enrollValues ? enrollValues : {}; const picked = v.classes || []; %>
      <form method="post" action="/enroll" class="enroll-form" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
        <label>Ad, soyad · Full name
          <input name="name" required autocomplete="name" value="<%= v.name || '' %>" placeholder="Adınız və soyadınız">
        </label>
        <label>Telefon nömrəsi · Telephone number
          <input name="phone" type="tel" required autocomplete="tel" inputmode="tel" value="<%= v.phone || '' %>" placeholder="+994 …">
        </label>
        <label>WhatsApp nömrəsi <span class="muted">(yalnız telefondan fərqlidirsə · only if different from phone)</span>
          <input name="whatsapp" type="tel" autocomplete="tel" inputmode="tel" value="<%= v.whatsapp || '' %>" placeholder="+994 …">
        </label>
        <fieldset class="enroll-classes">
          <legend>Fənn seçin · Choose class(es) <span class="muted">(ən azı biri · at least one)</span></legend>
          <% enroll.courses.forEach(c => { %>
            <label class="enroll-check"><input type="checkbox" name="classes" value="<%= c.code %>" <%= picked.includes(c.code)?'checked':'' %>>
              <span><b><%= c.title_az %></b> · <%= c.title %> <span class="muted">(<%= c.code %>)</span></span>
            </label>
          <% }) %>
        </fieldset>
        <button class="btn gold full enroll-submit" type="submit">Qeydiyyatı göndər · Submit enrollment</button>
      </form>
    <% } %>
  </div>
</section>
<%- include('partials/foot') %>
