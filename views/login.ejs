<%- include('partials/head') %>
<section class="login rise"><div class="card"><h1>Welcome · Xoş gəlmisiniz</h1>
<% if (typeof qrNote !== 'undefined' && qrNote) { %>
<p class="note qr-note">📱 Davamiyyət üçün bir dəfə daxil olun. Telefonunuz yadda saxlanılacaq.</p>
<div class="note qr-nologin">
  <b>Hələ girişiniz (login) yoxdur?</b>
  <p>Yenisinizsə, aşağıdakı düyməyə basın və qısa formanı doldurun. Davamiyyətiniz bu dərs üçün qeyd olunacaq. Pastor Bruce sizə tezliklə giriş məlumatlarınızı göndərəcək.</p>
  <a class="btn gold full qr-enroll-btn" href="<%= qrEnroll %>">Yeniyəm — qeydiyyatdan keç · I'm new, enroll me</a>
</div>
<% } else { %>
<p class="muted">Sign in to the Baku Bible Institute portal.</p>
<% } %>
<% if (error) { %><p class="err"><%= error %></p><% } %>
<form method="post" action="/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
<label>Email<input name="email" type="email" required autocomplete="username"></label><label>Password · Şifrə<input name="password" type="password" required autocomplete="current-password"></label><button class="btn full">Daxil ol · Sign in</button></form>
<% if (demo) { %><p class="muted small">Demo logins are listed in DEMO_LOGINS.md.</p><% } %></div></section>
<%- include('partials/foot') %>
