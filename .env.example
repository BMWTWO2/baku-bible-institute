PORT=3050
SESSION_SECRET=change-me-long-random
DEMO_MODE=true            # set false for real use (requires signed/secured webhook)
WHATSAPP_VERIFY_TOKEN=    # any long random string you choose; same value goes in Meta's webhook settings
WHATSAPP_APP_SECRET=      # Meta app secret, enables X-Hub-Signature-256 verification
HERALD_HOURS=48
OPENAI_API_KEY=           # optional: real AI Azeri drafts; empty = labeled SAMPLE drafts
DB_PATH=./data/bbi.sqlite
# SEED_SAMPLE_STUDENTS=false  # omit fictional student users, enrollments, grades, attendance, and homework
# BBI_EXTRA_USERS=   # optional JSON array of {name,email,role,password_hash,phone?}; applied after demo seed
HOMEWORK_API_TOKEN=      # 16+ random chars; lets the scheduled assistant post translations/drafts (docs/HOMEWORK_API.md)
DATABASE_URL=            # optional Postgres URL: durable snapshots of the whole DB (docs/PERSISTENCE.md)
# BBI_TEST_USERS=        # like BBI_EXTRA_USERS, for short-lived test accounts
EMAIL_SENDING_ENABLED=false  # kill switch; even when true, every email still needs Bruce's click in /admin/outbox
SENDGRID_API_KEY=
EMAIL_FROM=frontdoor4grace@gmail.com
EMAIL_FROM_NAME=Baku Bible Institute
EMAIL_REPLY_TO=
# BBI_ADMIN_PASSWORD_HASH=  # bcrypt hash used only when the admin account is first created
