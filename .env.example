PORT=3050
SESSION_SECRET=change-me-long-random
DEMO_MODE=true            # set false for real use (requires signed/secured webhook)
WHATSAPP_VERIFY_TOKEN=    # any long random string you choose; same value goes in Meta's webhook settings
WHATSAPP_APP_SECRET=      # Meta app secret, enables X-Hub-Signature-256 verification
HERALD_HOURS=48
OPENAI_API_KEY=           # optional: real AI Azeri drafts; empty = labeled SAMPLE drafts
DB_PATH=./data/bbi.sqlite
# BBI_EXTRA_USERS=   # optional JSON array of {name,email,role,password_hash}; applied after demo seed
